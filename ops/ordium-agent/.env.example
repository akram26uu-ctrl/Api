# Copy to /etc/ordium-agent/agent.env and chmod 600 it.
# Use a dedicated GitHub App/PAT with contents:read/write only for this repository.
GITHUB_TOKEN=REPLACE_WITH_REPOSITORY_SCOPED_TOKEN
ORDIUM_GITHUB_REPO=akram26uu-ctrl/Api
ORDIUM_BASE_BRANCH=main

# OpenRouter key and a model available to your OpenRouter account.
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
OPENROUTER_MODEL=openrouter/auto
# Optional comma-separated fallbacks; used only for unavailable models/transient failures, never for HTTP 429.
# OPENROUTER_FALLBACK_MODELS=provider/model-id,provider/backup-model-id

# Public endpoints or private localhost endpoints reachable from the EC2 host.
ORDIUM_PUBLIC_URL=https://ordium.dev
ORDIUM_WEB_URL=https://ordium.dev/
ORDIUM_WEB_HEALTH_URL=https://ordium.dev/readyz
ORDIUM_API_HEALTH_URL=https://api.ordium.dev/readyz
# Optional: enable only if this health endpoint is reachable and does not expose internals.
# ORDIUM_CONTROL_HEALTH_URL=https://ordium.dev/internal-healthz

# Exact CloudWatch log group names, comma-separated. EC2 IAM role must grant logs:FilterLogEvents.
AWS_REGION=REPLACE_WITH_EC2_REGION
ORDIUM_CLOUDWATCH_LOG_GROUPS=/ordium/containers

ORDIUM_AGENT_WORKSPACE=/opt/ordium-agent/workspace
ORDIUM_AGENT_INTERVAL_SECONDS=300
ORDIUM_MAX_FIXES_PER_DAY=3
ORDIUM_MAX_PATCH_BYTES=30000
LOG_LEVEL=INFO

# Direct commits bypass PR review; enable only after reviewing branch protections and permissions.
ORDIUM_ALLOW_DIRECT_PUSH=true

# Keep false until the real production checkout path and health URLs are verified.
# Auto-deploy uses the local EC2 checkout and Docker Compose; it never runs migrations.
ORDIUM_AUTO_DEPLOY=false
# ORDIUM_DEPLOY_DIR=/opt/ordium
ORDIUM_COMPOSE_FILE=compose.ec2.yaml
# ORDIUM_DEPLOY_ENV_FILE=/opt/ordium/.env.ec2
