APP_NAME=ORDIUM Control Plane
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
WEB_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
ORDIUM_API_URL=http://127.0.0.1:8000
ORDIUM_INTERNAL_SHARED_SECRET=replace-with-at-least-32-random-characters
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
SESSION_ENCRYPTION_KEY=replace-with-a-fernet-compatible-key
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
REQUIRE_EMAIL_VERIFICATION=true
PUBLIC_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
