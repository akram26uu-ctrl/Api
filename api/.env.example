APP_NAME=ORDIUM API
APP_VERSION=1.5.2
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/ordium
SECRET_KEY=replace-with-at-least-32-random-characters
NETWORK_INTELLIGENCE_PROVIDER=mock
IPQS_API_KEY=
IPQS_TIMEOUT_SECONDS=1.5
IPQS_CACHE_TTL_SECONDS=3600
IPQS_CACHE_MAX_ENTRIES=10000
IPQS_STRICTNESS=1
IPQS_MAX_CONCURRENT_LOOKUPS=20
TRUSTED_PROXY_NETWORKS=
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_DOCS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
ORDIUM_INTERNAL_SHARED_SECRET=replace-with-at-least-32-random-characters
MAX_REQUEST_BODY_BYTES=1048576
LIVE_REQUESTS_PER_MINUTE=120
TEST_REQUESTS_PER_MINUTE=300
LIVE_REQUESTS_PER_MINUTE_PER_MERCHANT=600
TEST_REQUESTS_PER_MINUTE_PER_MERCHANT=1500
IDEMPOTENCY_TTL_SECONDS=86400
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
