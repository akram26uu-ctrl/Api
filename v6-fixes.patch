diff --git a/api/app/services/webhook_service.py b/api/app/services/webhook_service.py
--- a/api/app/services/webhook_service.py
+++ b/api/app/services/webhook_service.py
@@ -1,5 +1,6 @@
 import logging
 import requests
+import time
 
 logger = logging.getLogger(__name__)
 
@@ -10,12 +11,18 @@
-def dispatch_webhook(endpoint_url: str, payload: dict, webhook_id: str):
-    try:
-        response = requests.post(endpoint_url, json=payload, timeout=5)
-        response.raise_for_status()
-        logger.info(f"Webhook {webhook_id} delivered successfully")
-        return True
-    except requests.RequestException as e:
-        logger.error(f"Webhook {webhook_id} failed: {e}")
-        return False
+MAX_RETRIES = 5
+
+def dispatch_webhook_with_retry(endpoint_url: str, payload: dict, webhook_id: str):
+    for attempt in range(MAX_RETRIES):
+        try:
+            response = requests.post(endpoint_url, json=payload, timeout=5)
+            response.raise_for_status()
+            logger.info(f"Webhook {webhook_id} delivered successfully on attempt {attempt + 1}")
+            return True
+        except requests.RequestException as e:
+            sleep_time = 2 ** attempt
+            logger.warning(f"Webhook {webhook_id} failed (attempt {attempt + 1}). Retrying in {sleep_time}s...")
+            time.sleep(sleep_time)
+    
+    logger.error(f"Webhook {webhook_id} permanently failed after {MAX_RETRIES} attempts.")
+    return False
