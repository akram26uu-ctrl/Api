# Copy to .env.ec2 at the repository root and protect it with chmod 600.
# This file is a placeholder example, not production-ready. Never commit .env.ec2.
# Keep DATABASE_URL and WEB_DATABASE_URL separate; they represent separate databases.

DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_SUPABASE_HOST:5432/REPLACE_RISK_DB?sslmode=require
WEB_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_SUPABASE_HOST:5432/REPLACE_CONTROL_DB?sslmode=require

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ORDIUM_INTERNAL_SHARED_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_ENCRYPTION_KEY=REPLACE_WITH_A_VALID_FERNET_KEY_GENERATED_LOCALLY

NETWORK_INTELLIGENCE_PROVIDER=ipqs
IPQS_API_KEY=REPLACE_WITH_REAL_IPQS_KEY

PUBLIC_BASE_URL=https://www.ordium.dev
WEB_ORIGINS=https://ordium.dev,https://www.ordium.dev
CORS_ALLOWED_ORIGINS=https://ordium.dev,https://www.ordium.dev
API_ALLOWED_HOSTS=api,api.ordium.dev,localhost,127.0.0.1

SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM="ORDIUM <no-reply@ordium.dev>"

SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STORE_MAP={}
OMNITERRA_WEBHOOK_SECRET=
OMNITERRA_SIGNATURE_HEADER=X-Omniterra-Hmac-Sha256
OMNITERRA_EVENT_ID_HEADER=X-Omniterra-Webhook-Id
OMNITERRA_STORE_MAP={}

DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
